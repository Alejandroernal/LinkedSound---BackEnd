generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Role {
  id          String     @id @default(uuid()) @db.Uuid
  name        String     @unique @db.VarChar(50)
  description String?
  createdAt   DateTime   @default(now()) @db.Timestamptz

  users       UserRole[]

  @@map("Role")
}

model UserStatus {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(50)
  description String?
  createdAt   DateTime @default(now()) @db.Timestamptz

  users       User[]

  @@map("UserStatus")
}

model EventStatus {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(50)
  description String?
  createdAt   DateTime @default(now()) @db.Timestamptz

  events      Event[]

  @@map("EventStatus")
}

model EventType {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(50)
  description String?
  createdAt   DateTime @default(now()) @db.Timestamptz

  events      Event[]

  @@map("EventType")
}

model ReportStatus {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(50)
  description String?
  createdAt   DateTime @default(now()) @db.Timestamptz

  reports     Report[]

  @@map("ReportStatus")
}

model User {
  id               String       @id @default(uuid()) @db.Uuid
  email            String       @unique @db.VarChar(255)
  password         String       @db.VarChar(255)
  firstName        String       @db.VarChar(100)
  lastName         String       @db.VarChar(100)
  nickname         String       @unique @db.VarChar(50)
  role             String?      @default("Artista") @db.VarChar(50)
  profileImage     String?
  description      String?
  soundcloudUrl    String?      @db.VarChar(255)
  spotifyUrl       String?      @db.VarChar(255)
  instagramUrl     String?      @db.VarChar(255)
  soundcloudHandle String?      @db.VarChar(100)
  locationId       String?      @db.Uuid
  location         Location?    @relation(fields: [locationId], references: [id], onDelete: SetNull)
  statusId         String?      @db.Uuid
  userStatus       UserStatus?  @relation(fields: [statusId], references: [id], onDelete: Restrict)
  status           String       @default("Active") @db.VarChar(50)
  reportsCount     Int          @default(0)
  createdAt        DateTime     @default(now()) @db.Timestamptz
  updatedAt        DateTime     @default(now()) @updatedAt @db.Timestamptz

  roles                UserRole[]
  genres               ProfileGenre[]
  favoriteArtists      UserFavoriteArtist[]
  tracks               Track[]
  events               Event[]
  sentInteractions     Interaction[]     @relation("SentInteractions")
  receivedInteractions Interaction[]     @relation("ReceivedInteractions")
  matchesAsUser1       Match[]           @relation("User1Matches")
  matchesAsUser2       Match[]           @relation("User2Matches")
  sentReports          Report[]          @relation("ReporterReports")
  receivedReports      Report[]          @relation("ReportedReports")
  sentMessages         Message[]         @relation("SentMessages")
  conversationsAsUser1 Conversation[]    @relation("ConversationUser1")
  conversationsAsUser2 Conversation[]    @relation("ConversationUser2")
  activityLogs         UserActivityLog[]
  notifications        Notification[]

  @@map("User")
}

model UserRole {
  userId     String   @db.Uuid
  roleId     String   @db.Uuid
  assignedAt DateTime @default(now()) @db.Timestamptz

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("UserRole")
}

model Location {
  id               String    @id @default(uuid()) @db.Uuid
  name             String?   @db.VarChar(150)
  formattedAddress String    @db.VarChar(255)
  country          String?   @db.VarChar(100)
  province         String?   @db.VarChar(100)
  city             String?   @db.VarChar(100)
  streetAddress    String?   @db.VarChar(150)
  latitude         Float?
  longitude        Float?
  createdAt        DateTime  @default(now()) @db.Timestamptz
  updatedAt        DateTime  @default(now()) @updatedAt @db.Timestamptz

  users            User[]
  events           Event[]

  @@map("Location")
}

model Genre {
  id          String         @id @default(uuid()) @db.Uuid
  name        String         @unique @db.VarChar(50)
  slug        String         @unique @db.VarChar(60)
  description String?
  createdAt   DateTime       @default(now()) @db.Timestamptz

  profileGenres ProfileGenre[]
  eventGenres   EventGenre[]
  trackGenres   TrackGenre[]
  tracks        Track[]

  @@map("Genre")
}

model ProfileGenre {
  userId    String   @db.Uuid
  genreId   String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  genre     Genre    @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([userId, genreId])
  @@map("ProfileGenre")
}

model Artist {
  id         String               @id @default(uuid()) @db.Uuid
  spotifyId  String?              @unique @db.VarChar(100)
  name       String               @db.VarChar(150)
  imageUrl   String?              @db.VarChar(500)
  spotifyUrl String?              @db.VarChar(255)
  genres     String[]             @default([])
  createdAt  DateTime             @default(now()) @db.Timestamptz

  users      UserFavoriteArtist[]

  @@map("Artist")
}

model UserFavoriteArtist {
  userId    String   @db.Uuid
  artistId  String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  artist    Artist   @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@id([userId, artistId])
  @@map("UserFavoriteArtist")
}

model EventGenre {
  eventId   String   @db.Uuid
  genreId   String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz

  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  genre     Genre    @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([eventId, genreId])
  @@map("EventGenre")
}

model Track {
  id             String       @id @default(uuid()) @db.Uuid
  title          String       @db.VarChar(150)
  plays          Int          @default(0)
  duration       String       @default("0:00") @db.VarChar(10)
  genreId        String?      @db.Uuid
  genre          Genre?       @relation(fields: [genreId], references: [id], onDelete: SetNull)
  audioUrl       String?      @db.VarChar(500)
  soundcloudLink String?      @db.VarChar(500)
  userId         String?      @db.Uuid
  user           User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventId        String?      @db.Uuid
  event          Event?       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now()) @db.Timestamptz

  trackGenres    TrackGenre[]

  @@map("Track")
}

model TrackGenre {
  trackId   String   @db.Uuid
  genreId   String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz

  track     Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  genre     Genre    @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([trackId, genreId])
  @@map("TrackGenre")
}

model Event {
  id             String       @id @default(uuid()) @db.Uuid
  title          String       @db.VarChar(100)
  nickname       String       @db.VarChar(100)
  eventTypeId    String?      @db.Uuid
  eventType      EventType?   @relation(fields: [eventTypeId], references: [id], onDelete: SetNull)
  eventDate      DateTime     @db.Date
  eventTime      String?      @db.VarChar(8)
  venue          String?      @db.VarChar(100)
  ticketUrl      String?      @db.VarChar(500)
  description    String?
  profileImage   String?
  locationId     String?      @db.Uuid
  location       Location?    @relation(fields: [locationId], references: [id], onDelete: SetNull)
  statusId       String?      @db.Uuid
  eventStatus    EventStatus? @relation(fields: [statusId], references: [id], onDelete: Restrict)
  status         String       @default("Active") @db.VarChar(50)
  reportsCount   Int          @default(0)
  soundcloudUrl  String?      @db.VarChar(255)
  spotifyUrl     String?      @db.VarChar(255)
  instagramUrl   String?      @db.VarChar(255)
  ownerId        String       @db.Uuid
  owner          User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now()) @db.Timestamptz
  updatedAt      DateTime     @default(now()) @updatedAt @db.Timestamptz

  genres         EventGenre[]
  tracks         Track[]
  reports        Report[]     @relation("EventReports")

  @@map("Event")
}

model Interaction {
  id         String   @id @default(uuid()) @db.Uuid
  senderId   String   @db.Uuid
  receiverId String   @db.Uuid
  isLike     Boolean
  createdAt  DateTime @default(now()) @db.Timestamptz

  sender     User     @relation("SentInteractions", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   User     @relation("ReceivedInteractions", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
  @@map("Interaction")
}

model Match {
  id              String   @id @default(uuid()) @db.Uuid
  user1Id         String   @db.Uuid
  user2Id         String   @db.Uuid
  affinityPercent String?  @db.VarChar(10)
  matchedAt       DateTime @default(now()) @db.Timestamptz
  createdAt       DateTime @default(now()) @db.Timestamptz

  user1           User     @relation("User1Matches", fields: [user1Id], references: [id], onDelete: Cascade)
  user2           User     @relation("User2Matches", fields: [user2Id], references: [id], onDelete: Cascade)

  @@unique([user1Id, user2Id])
  @@map("Match")
}

model Conversation {
  id        String    @id @default(uuid()) @db.Uuid
  user1Id   String    @db.Uuid
  user2Id   String    @db.Uuid
  pinned    Boolean   @default(false)
  muted     Boolean   @default(false)
  blocked   Boolean   @default(false)
  createdAt DateTime  @default(now()) @db.Timestamptz
  updatedAt DateTime  @default(now()) @updatedAt @db.Timestamptz

  user1     User      @relation("ConversationUser1", fields: [user1Id], references: [id], onDelete: Cascade)
  user2     User      @relation("ConversationUser2", fields: [user2Id], references: [id], onDelete: Cascade)
  messages  Message[]

  @@unique([user1Id, user2Id])
  @@map("Conversation")
}

model Message {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @db.Uuid
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String       @db.Uuid
  sender         User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  text           String?
  isRead         Boolean      @default(false)
  readAt         DateTime?    @db.Timestamptz
  attachmentUrl  String?      @db.VarChar(500)
  attachmentType String?      @db.VarChar(50)
  attachmentName String?      @db.VarChar(255)
  attachmentSize String?      @db.VarChar(50)
  createdAt      DateTime     @default(now()) @db.Timestamptz

  @@map("Message")
}

model Report {
  id              String        @id @default(uuid()) @db.Uuid
  reporterUserId  String        @db.Uuid
  reportedUserId  String?       @db.Uuid
  reportedEventId String?       @db.Uuid
  reason          String        @db.VarChar(100)
  details         String
  statusId        String?       @db.Uuid
  reportStatus    ReportStatus? @relation(fields: [statusId], references: [id], onDelete: Restrict)
  status          String        @default("Pending") @db.VarChar(50)
  severity        String        @default("Medium") @db.VarChar(20)
  origin          String        @default("Discovery") @db.VarChar(50)
  targetType      String?       @db.VarChar(20)
  adminComment    String?
  createdAt       DateTime      @default(now()) @db.Timestamptz

  reporter        User          @relation("ReporterReports", fields: [reporterUserId], references: [id], onDelete: Cascade)
  reportedUser    User?         @relation("ReportedReports", fields: [reportedUserId], references: [id], onDelete: SetNull)
  reportedEvent   Event?        @relation("EventReports", fields: [reportedEventId], references: [id], onDelete: SetNull)

  @@map("Report")
}

model UserActivityLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  action    String   @db.VarChar(255)
  ip        String   @default("127.0.0.1") @db.VarChar(45)
  device    String   @db.VarChar(255)
  module    String   @db.VarChar(50)
  createdAt DateTime @default(now()) @db.Timestamptz

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("UserActivityLog")
}

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  title     String    @db.VarChar(150)
  message   String
  isRead    Boolean   @default(false)
  readAt    DateTime? @db.Timestamptz
  type      String    @db.VarChar(50)
  linkPage  String?   @db.VarChar(100)
  createdAt DateTime  @default(now()) @db.Timestamptz

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("Notification")
}
